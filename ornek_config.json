{
  "_aciklama": "YSA tarama konfigürasyonu. '_' ile başlayan alanlar açıklamadır, program okumaz. Ayrıntı: YSA_KULLANIM.md",

  "veri": {
    "dosya": "ornek_veri/cumg04_tel_cekme_SENTETIK.xlsx",
    "sayfa": 0,
    "girdiler": ["Mg_orani_agirlik%", "Hadde_sayisi", "Redüksiyon_%", "Cekme_hizi_m/s", "Kalip_malzemesi"],
    "ciktilar": ["Cekme_dayanimi_MPa", "Sertlik_HV", "Iletkenlik_%IACS", "Enerji_kWh/ton"],
