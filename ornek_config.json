  "egitim_algoritmalari": ["trainlm", "trainbr"],
  "gizli_aktivasyonlar": ["tansig"],
  "cikis_aktivasyonu": "purelin",
  "tekrar": 3,
  "tohum": 2024,

  "egitim_parametreleri": {"epochs": 500, "max_fail": 6, "goal": 0.0, "min_grad": 1e-7},
  "algoritma_parametreleri": {"trainlm": {"mu": 0.001}, "trainbr": {"epochs": 300}},

  "secim_kriteri": "val_mse",
  "paralel_is": -1,
  "en_iyi_k": 10,
  "cikti_klasoru": "ysa_sonuclar",
